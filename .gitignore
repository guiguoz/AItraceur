# ============================================
# AItraceur — .gitignore
# ============================================

# ---- Python / Backend ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
.env
.venv/
venv/
env/
*.db
*.sqlite
*.sqlite3

# Uploads et fichiers temporaires
backend/uploads/
backend/tile-service/uploads/
backend/tile-service/renders/
backend/tile-service/tiles/

# Lidar / données volumineuses
*.laz
*.las
*.tiff
*.tif
*.geotiff

# Archives volumineuses
*.tar.gz
*.gz
# Lora model weights (heavy binaries) — but track text datasets (.jsonl)
Lora/*.safetensors
Lora/*.bin
Lora/*.gguf
Lora/*.pt
Lora/*.ckpt
Lora/*.model

# ---- Node.js / Tile service & Frontend ----
node_modules/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build frontend
frontend/dist/
frontend/.vite/

# ---- Données sensibles ----
.env.local
.env.*.local
*.pem
*.key
*.cert
secrets/
credentials/

# ---- Éditeurs / OS ----
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# ---- Claude Code (mémoire privée) ----
.claude/

# ---- Qodo (outil interne) ----
.qodo/
.qoder/

# ---- Tauri (desktop app, pas prioritaire) ----
src-tauri/target/

# ---- Logs ----
*.log
logs/

# ---- Divers ----
.cache/
tmp/
temp/

# Dataset images ML (volumineuses)
backend/data/rg2/dataset/
backend/data/rg2/dataset_archive_238k/

# GeoJSON RG2 volumineux (>100MB, données brutes de scraping)
backend/data/rg2/rg2_controls.geojson
backend/data/rg2/rg2_scrape_log.json

# Outils binaires locaux
curl.exe
poppler/
tools/
backend/data/models/best_model.pth
*.pth
*.pt
*.onnx.data

# Vikazimut dataset (volumineuse — >500MB localement)
vikazimut/parcours/
vikazimut/traces/
vikazimut/maps/
vikazimut/patches/
vikazimut/index.json
vikazimut/stats.json

# Dossiers non-versionés
AItraceur/
xml/
backend/data/rg2/

# Sorties scripts
backend/output/
backend/tests/output/
backend/data/candidates.json
